name: Update GitHub Stats SVGs

on:
  schedule:
    - cron: '0 */6 * * *'   # every 6 hours
  workflow_dispatch: {}      # lets you trigger it manually from the Actions tab

jobs:
  update-stats:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Generate stats SVG
        run: |
          mkdir -p assets
          curl -s "https://github-readme-stats.vercel.app/api?username=IDjosh-Git&show_icons=true&theme=default" -o assets/stats.svg
          curl -s "https://github-readme-stats.vercel.app/api/top-langs/?username=IDjosh-Git&layout=compact&theme=default" -o assets/top-langs.svg

      - name: Commit and push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add assets/stats.svg assets/top-langs.svg
          git diff --quiet && git diff --staged --quiet || (git commit -m "Update stats SVGs" && git push)
